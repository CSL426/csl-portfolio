{
  "name": "csl-portfolio",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:web": "pnpm --filter @spark/web dev",
    "build:web": "pnpm --filter @spark/web build",
    "preview:web": "pnpm --filter @spark/web preview",
    "type-check": "pnpm --filter @spark/web type-check",
    "lint:web": "pnpm --filter @spark/web lint",
    "test:web": "pnpm --filter @spark/web test",
    "dev:api": "uv run --project apps/api uvicorn server.main:app --reload --port 8000",
    "test:api": "uv run --project apps/api pytest",
    "lint:api": "uv run --project apps/api ruff check",
    "format:api": "uv run --project apps/api ruff format",
    "typecheck:api": "uv run --project apps/api --directory apps/api mypy",
    "update:profile": "pnpm --filter @spark/web exec vitest run -u",
    "check": "pnpm type-check && pnpm lint:web && pnpm test:web && pnpm lint:api && pnpm typecheck:api && pnpm test:api"
  }
}
