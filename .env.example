# Repo-root .env — both apps/api (FastAPI) and docker-compose read from here.
# Copy to .env and fill in. Per-app override: apps/api/.env wins over root .env.

# ──────────────────────────── Public surface ─────────────────────────────────
# THE ONLY port published to the host. API + nginx live on docker's internal
# network; everything reachable from outside comes through this one port.
PUBLIC_PORT=8787

# ──────────────────────────── Backend (apps/api) ─────────────────────────────

APP_ENV=dev
LOG_LEVEL=INFO

# CORS (JSON array). If unset, defaults to http://localhost:5173 pair.
# CORS_ORIGINS='["http://localhost:5173","https://your.domain"]'

# --- LINE Messaging API ---
# https://developers.line.biz/console/
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# --- Agents ---
# echo | adk | claude  (a message starting with /<name> picks that agent)
DEFAULT_AGENT=claude

# --- Google ADK / Gemini ---
# Google AI Studio key — https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=
ADK_MODEL=gemini-3.5-flash-lite
ADK_APP_NAME=csl-portfolio

# --- Claude (Anthropic API) ---
# https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
# Only for keys NOT scoped to one workspace; sent as the anthropic-workspace-id header.
ANTHROPIC_WORKSPACE_ID=
CLAUDE_MODEL=claude-haiku-5-5
# low | medium | high | xhigh | max
CLAUDE_EFFORT=low

# --- Public /api/chat limits ---
CHAT_LIMIT_PER_SESSION_PER_MINUTE=10
CHAT_LIMIT_PER_IP_PER_MINUTE=30
CHAT_LIMIT_PER_DAY=1000
